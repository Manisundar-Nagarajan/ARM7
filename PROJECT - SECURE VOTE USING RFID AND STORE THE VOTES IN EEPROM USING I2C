/************ UART Configuration **************/
void UART_CONFIG(void)
{
	PINSEL0|=0X05;
	U0LCR=0X83;
	U0DLL=97;
	U0DLM=0;
	U0LCR=0X03;
}
/************ UART Recive Configuration **************/
unsigned char UART_RX(void)
{
	while((U0LSR&1)==0);
	return U0RBR;
}

